{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Survey",
  "version": "0.1.0",
  "identifier": "io.github.jasonswrench-beep.prismsurvey",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ../ui run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prism Survey",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Prism Survey contributors",
    "copyright": "Apache License 2.0",
    "shortDescription": "Turn published measures into correctly scored scales for Word questionnaires",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "pscale"
        ],
        "name": "Prism Survey scale",
        "description": "Prism Survey scale",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../../addons/comm-directory/directory.json": "addons/comm-directory/directory.json",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD-PARTY.md": "THIRD-PARTY.md",
      "../ui/src/assets/fonts/Inter-OFL.txt": "Inter-OFL.txt"
    }
  }
}
