        "title": "Weekend Plans Scale (Practice)",
        "countSuffix": false,
        "tags": [
          "practice",
          "students"
        ],
        "format": "likertBlankLine",
        "response": {
          "points": 5,
          "anchorSet": "frequency",
          "labelMode": "every",
          "labels": [
            "Never",
            "Rarely",
            "Occasionally",
            "Often",
