            "text": "I make plans with friends for the weekend.",
            "reverse": {
              "state": "notReversed"
            }
          },
          {
            "number": 5,
            "text": "I finish the weekend tasks I set for myself.",
            "reverse": {
              "state": "notReversed"
            }
          }
        ],
        "recode": {
